set cpu 8m
set cpu noidle
set rq0 ra81
attach rq0 @SESSION_RQ0@
set rq1 disabled
set rq2 disabled
set rq3 disabled
set rp disabled
set hk disabled
set rl disabled
set tq disabled
set tu disabled
set ts disabled
set dz disabled
set lpt disabled
set xu disabled
set xub disabled
set tti 7b
set tto 7b
load -o @RUNTIME_BOOT@ 0
deposit r10 9
deposit r11 0
; Operator-assisted boot: at sim>, type run 2; at Boot, accept ra(0,0)vmunix.
