; UNIX Time Machine: HUMAN_REQUIRED UNIX V7 tape/bootstrap phase
; V7 standalone installation uses the documented Open SIMH PDP-11/45 profile.
; Open SIMH's initial 256 KiB memory size is the maximum for an 11/45.
; The tape is attached read-only; both RP06 images continue into runtime verification.
set cpu 11/45
set cpu 256K
set cpu idle
set clk 60Hz
set lpt disabled
set ptr disabled
set ptp disabled
set cr disabled
set rk disabled
set rl disabled
set hk disabled
set rx disabled
set rq disabled
set tq disabled
set ts disabled
set dz disabled
set vh disabled
set xq disabled
set xu disabled
set rp enabled
set rp0 rp06
set rp1 rp06
set rp2 disabled
set rp3 disabled
set rp4 disabled
set rp5 disabled
set rp6 disabled
set rp7 disabled
set tm enabled
set console log=@INSTALL_BOOTSTRAP_CONSOLE_LOG@
attach rp0 @STAGING_RP0@
attach rp1 @STAGING_RP1@
attach -r tm0 @INSTALL_TAPE@
boot tm0
