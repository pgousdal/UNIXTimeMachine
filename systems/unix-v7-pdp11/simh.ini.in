; UNIX Time Machine: UNIX Seventh Edition / PDP-11/70
; Runtime tokens are replaced by scripts/utm.py. Do not run this template directly.
; After boot rp0, V7 hpuboot is silent: type boot and Return.  At the Boot/: prompt
; from /boot, type hp(0,0)unix and Return.
set cpu 11/70
set cpu 2M
set cpu idle
set clk 60Hz
set lpt disabled
set ptr disabled
set ptp disabled
set cr disabled
set rk disabled
set rl disabled
set hk disabled
set rx disabled
set rq disabled
set tq disabled
set tm disabled
set ts disabled
set dz disabled
set vh disabled
set xq disabled
set xu disabled
set rp enabled
set rp0 rp06
set rp1 rp06
set rp2 disabled
set rp3 disabled
set rp4 disabled
set rp5 disabled
set rp6 disabled
set rp7 disabled
set console log=@CONSOLE_LOG@
attach rp0 @SESSION_RP0@
attach rp1 @SESSION_RP1@
boot rp0
